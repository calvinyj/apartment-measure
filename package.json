{
  "name": "apartment-measure",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.ts\" \"vite\"",
    "build": "tsc -p . && tsc -p server && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p server"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "pdfmake": "^0.3.11",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
